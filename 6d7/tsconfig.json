{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@rules/*": [
        "../dnd-rules/src/*"
      ],
      "@rules-data/*": [
        "../dnd-rules/data/*"
      ],
      "dnd-sheet": [
        "../dnd-rules/src/sheet/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
